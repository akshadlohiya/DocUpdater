                padding: 20px;
            }}
        }}
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 PDF Comparison Report</h1>
            <p>Comprehensive analysis of PDF differences</p>
        </div>
        
        <div class="content">
            <div class="summary">
                <h2>✓ Comparison Summary</h2>
                <div class="summary-item">
                    <span class="summary-label">Status</span>
                    <span class="status-badge">✓ Completed Successfully</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Timestamp</span>
                    <span class="summary-value">{timestamp}</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">PDF 1 Images</span>
                    <span class="summary-value">{pdf1_info.get('images_extracted', 0)} extracted</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">PDF 2 Images</span>
                    <span class="summary-value">{pdf2_info.get('images_extracted', 0)} extracted</span>
                </div>
            </div>
            
            <div class="info-grid">
                <div class="info-card">
                    <h3>📄 PDF 1 (Original)</h3>
                    <span class="label">File Path:</span>
                    <div class="value">{pdf1_path}</div>
                    <span class="label">Images Extracted:</span>
                    <div class="value">{pdf1_info.get('images_extracted', 0)}</div>
                </div>
                
                <div class="info-card">
                    <h3>📄 PDF 2 (Comparison)</h3>
                    <span class="label">File Path:</span>
                    <div class="value">{pdf2_path}</div>
                    <span class="label">Images Extracted:</span>
                    <div class="value">{pdf2_info.get('images_extracted', 0)}</div>
                </div>
            </div>
            
            <div class="info-card">
                <h3>🔍 Comparison Details</h3>
                <span class="label">Result PDF:</span>
                <div class="value">{comparison_info.get('result_pdf', 'N/A')}</div>
                <span class="label">Temporary Directory:</span>
                <div class="value">{comparison_info.get('temp_directory', 'N/A')}</div>
            </div>
        </div>
        
        <div class="footer">
            <p>Report generated by GUI Agent v2.0 PDF Comparison Tool</p>
            <p style="margin-top: 10px; font-size: 0.85em;">© 2026 - Automated Documentation Engine</p>
        </div>
    </div>
</body>
</html>"""
        
        # Ensure output directory exists
        output_dir = os.path.dirname(output_html_path)
        if output_dir and not os.path.exists(output_dir):
            os.makedirs(output_dir)
        
        # Write HTML file
        with open(output_html_path, 'w', encoding='utf-8') as f:
            f.write(html_content)
        
        print(f"[PDF Compare] HTML report generated: {output_html_path}")
        
        return {
            "success": True,
            "html_path": output_html_path,
            "size": os.path.getsize(output_html_path)
        }
    
    except Exception as e:
        print(f"[PDF Compare] Error generating HTML report: {e}")
        return {
            "success": False,
            "error": str(e)
        }


def browse_directory(path="/"):
    """
    Browse directory structure and list files/folders.
    Limited to user home directory for security.
    
    Args:
        path (str): Directory path to browse
        
    Returns:
        dict: Directory contents and metadata
    """
    try:
        # Get user home directory
        home = str(Path.home())
        
        # If path is empty or root, start from home
        if path == "/" or path == "\\" or not path:
            current_path = home
        else:
            # Normalize path
            current_path = os.path.normpath(path)
            
            # Security: Only allow browsing within home directory
            abs_current = os.path.abspath(current_path)
            abs_home = os.path.abspath(home)
            
            if not abs_current.startswith(abs_home):
                # Try to return to home if outside home directory
                current_path = home
        
        if not os.path.exists(current_path):
            current_path = home
        
        # Check if path is accessible
        if not os.access(current_path, os.R_OK):
            return {
                "success": False,
                "error": "Permission denied - cannot access this folder",
                "current_path": current_path
            }
        
        items = []
        
        try:
            entries = sorted(os.listdir(current_path))
        except PermissionError:
            return {
                "success": False,
                "error": "Permission denied",
                "current_path": current_path
            }
        
        # Get parent path (but don't allow above home directory)
        parent_path = os.path.dirname(current_path)
        if not parent_path.startswith(os.path.abspath(home)):
            parent_path = home
        
        for entry in entries:
            try:
                entry_path = os.path.join(current_path, entry)
                
                # Skip hidden files on Unix
                if entry.startswith('.'):
                    continue
                
                # Check if it's accessible
                if not os.access(entry_path, os.R_OK):
                    continue
                
                if os.path.isdir(entry_path):
                    items.append({
                        "name": entry,
                        "type": "folder",
                        "path": entry_path,
                        "readable": True
                    })
                elif os.path.isfile(entry_path):
                    # Show PDF files
                    if entry.lower().endswith(('.pdf', '.exe', '.app', '.sh')):
                        items.append({
                            "name": entry,
                            "type": "file",
                            "path": entry_path,
                            "readable": True
                        })
            except (PermissionError, OSError):
                continue
        
        return {
            "success": True,
            "current_path": current_path,
            "parent_path": parent_path,
            "items": items
        }
    
    except Exception as e:
        return {
            "success": False,
            "error": str(e)
        }


def get_comparison_images(comparison_dir):
    """
    Get images from comparison directory for web display.
    
    Args:
        comparison_dir (str): Directory containing extracted images
        
    Returns:
        dict: Organized image paths by page
    """
    try:
        images = {}
        
        if not os.path.exists(comparison_dir):
            return images
        
        # Organize images by page
        for filename in sorted(os.listdir(comparison_dir)):
            if filename.endswith(('.png', '.jpg', '.jpeg')):
                path = os.path.join(comparison_dir, filename)
                # Extract page number from filename
                parts = filename.split('_')
                page_num = parts[0].replace('page', '')
                
                if page_num not in images:
                    images[page_num] = []
                
                images[page_num].append({
                    "filename": filename,
                    "path": path
                })
        
        return images
    
    except Exception as e:
        print(f"Error reading comparison images: {e}")
        return {}