        }}
        
        .summary-item {{
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(0, 255, 150, 0.1);
        }}
        
        .summary-item:last-child {{
            border-bottom: none;
        }}
        
        .summary-label {{
            color: #80b0ff;
            font-weight: 500;
        }}
        
        .summary-value {{
            color: #00ff88;
            font-weight: 600;
        }}
        
        .footer {{
            background: rgba(0, 0, 0, 0.3);
            border-top: 1px solid rgba(100, 200, 255, 0.2);
            padding: 20px 40px;
            text-align: center;
